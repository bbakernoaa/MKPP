{#
  Standard Rosenbrock integrate() function template.

  Renders the complete integrate() function with:
  - Function signature (template parameter, KOKKOS_INLINE_FUNCTION)
  - Solver constants (g, safety, max_growth, min_shrink)
  - Time-stepping while loop
  - State hoisting into scalars (S_i)
  - Jacobian evaluation (J_i_j)
  - W-matrix formation (emit_w_matrix macro)
  - LU factorization (emit_lu_factorize macro)
  - Rosenbrock stage loop (fully unrolled at template-render time)
  - Error estimation and step-size control
  - Accept/reject logic with state update

  Context variables required:
    num_species          - int
    tableau              - dict with name, stages, ELO, Gamma, M, E, NewF, A_matrix, C_matrix
    jacobian_entries     - list of (i, j, expr_str) tuples
    needed_w             - sorted list of (i, j) tuples
    non_zero_jac_set     - set of (i, j) tuples
    lu_expressions       - list of dicts {kind, i, j, expr}
    forward_sub_steps    - list of dicts {i, raw_expr}
    backward_sub_steps   - list of dicts {i, raw_expr}
    f_exprs              - list of C++ rate expressions per species
    permutation          - list of int or None
    blocks               - list of block dicts or None
    has_equilibrium      - bool
    tolerance_arrays     - dict with atol, rtol lists

  Requirements: 4.1
#}
{% from "macros/w_matrix.j2" import emit_w_matrix %}
{% from "macros/lu_factorize.j2" import emit_lu_factorize %}
{% from "macros/lu_solve_forward.j2" import emit_forward_sub %}
{% from "macros/lu_solve_backward.j2" import emit_backward_sub %}
      template <class StateView>
{% if has_equilibrium %}
      KOKKOS_INLINE_FUNCTION void integrate(double dt_total, StateView& state, const double* jvals, const double temp, const double rh) const {
          const double Temp = temp;
          const double RH = rh;
          (void)RH;  // Reserved for future deliquescence modeling
{% else %}
      KOKKOS_INLINE_FUNCTION void integrate(double dt_total, StateView& state, const double* jvals) const {
{% endif %}
          const int NUM_SPECIES = {{ num_species }};
          // {{ tableau.name }} coefficients ({{ tableau.stages }}-stage, order {{ tableau.ELO | int }})
          const double g = {{ "%.17g" | format(tableau.Gamma[0]) }};
          const double safety = 0.9;
          const double max_growth = 6.0;
          const double min_shrink = 0.2;
          double t = 0.0;
          double dt = Kokkos::fmin(dt_total, 1.0);  // conservative initial step

          while (t < dt_total) {
          dt = Kokkos::min(dt, dt_total - t);
          const double inv_g_dt = 1.0 / (g * dt);

          // 0. Hoist state values into scalar registers
{% if permutation %}
          // NOTE: State access uses permuted species ordering
{% endif %}
{% for i in range(num_species) %}
{% if permutation %}
          const double S_{{ i }} = state({{ permutation[i] }});
{% else %}
          const double S_{{ i }} = state({{ i }});
{% endif %}
{% endfor %}

          // Analytical Jacobian & Iteration Matrix W = inv_g_dt*I - J (sparse)
{% for entry in jacobian_entries %}
          double J_{{ entry[0] }}_{{ entry[1] }} = {{ entry[2] }};
{% endfor %}
{{ emit_w_matrix(needed_w, non_zero_jac_set, "inv_g_dt", num_species, is_reduction=false, blocks=none, indent="          ") }}
          // Symbolic Doolittle Sparse LU Factorization
{% if blocks %}
{% set blk_ns = namespace(emitted_block_nums=[]) %}
{% for entry in lu_expressions %}
{% for block_num in range(blocks | length) %}
{% if entry.i in blocks[block_num].indices and block_num not in blk_ns.emitted_block_nums %}
{% set blk_ns.emitted_block_nums = blk_ns.emitted_block_nums + [block_num] %}
          // Block {{ block_num }}: species [{{ blocks[block_num].species_names | join(', ') }}]
{% endif %}
{% endfor %}
          double {{ entry.kind }}_{{ entry.i }}_{{ entry.j }} = {{ entry.expr }};
{% endfor %}
{% else %}
{% for entry in lu_expressions %}
          double {{ entry.kind }}_{{ entry.i }}_{{ entry.j }} = {{ entry.expr }};
{% endfor %}
{% endif %}
{% set ns = namespace(current_F_prefix="", rhs_prefix="") %}
{% for stage in range(1, tableau.stages + 1) %}

          // --- Stage {{ stage }} ---
{% if stage > 1 %}
          // Intermediate state Y{{ stage }}
{% for i in range(num_species) %}
{% set terms = [] %}
{% for j in range(1, stage) %}
{% set a_idx = (stage - 1) * (stage - 2) // 2 + j - 1 %}
{% set a_val = tableau.A_matrix[a_idx] %}
{% if a_val != 0.0 %}
{% set _ = terms.append((a_val, "K" ~ j ~ "_" ~ i)) %}
{% endif %}
{% endfor %}
{% if terms | length == 0 %}
          double Y{{ stage }}_{{ i }} = S_{{ i }};
{% elif terms | length == 1 and terms[0][0] == 1.0 %}
          double Y{{ stage }}_{{ i }} = S_{{ i }} + {{ terms[0][1] }};
{% else %}
{% set sum_parts = [] %}
{% for t in terms %}
{% if t[0] == 1.0 %}
{% set _ = sum_parts.append(t[1]) %}
{% else %}
{% set _ = sum_parts.append("%.17g" | format(t[0]) ~ " * " ~ t[1]) %}
{% endif %}
{% endfor %}
          double Y{{ stage }}_{{ i }} = S_{{ i }} + {{ sum_parts | join(" + ") }};
{% endif %}
{% endfor %}
{% endif %}
{% if tableau.NewF[stage - 1] %}
{% if stage == 1 %}
          // Rate evaluation F{{ stage }} at S
{% for i in range(num_species) %}
          double F{{ stage }}_{{ i }} = {{ f_exprs[i] }};
{% endfor %}
{% set ns.current_F_prefix = "F" ~ stage %}
{% else %}
          // Rate evaluation F{{ stage }} at Y{{ stage }}
{% for i in range(num_species) %}
{% set stage_expr = f_exprs[i] | replace("S_", "Y" ~ stage ~ "_") %}
          double F{{ stage }}_{{ i }} = {{ stage_expr }};
{% endfor %}
{% set ns.current_F_prefix = "F" ~ stage %}
{% endif %}
{% else %}
          // NewF=false: reuse {{ ns.current_F_prefix }} for stage {{ stage }}
{% endif %}
{% if stage == 1 %}
{% set ns.rhs_prefix = ns.current_F_prefix %}
{% else %}
          // RHS for stage {{ stage }}
{% for i in range(num_species) %}
{% set c_terms = [] %}
{% for j in range(1, stage) %}
{% set c_idx = (stage - 1) * (stage - 2) // 2 + j - 1 %}
{% set c_val = tableau.C_matrix[c_idx] %}
{% if c_val != 0.0 %}
{% set _ = c_terms.append((c_val, "K" ~ j ~ "_" ~ i)) %}
{% endif %}
{% endfor %}
{% if c_terms | length == 0 %}
          double rhs{{ stage }}_{{ i }} = {{ ns.current_F_prefix }}_{{ i }};
{% else %}
{% set sum_parts = [] %}
{% for t in c_terms %}
{% set _ = sum_parts.append("(" ~ ("%.17g" | format(t[0])) ~ " / dt) * " ~ t[1]) %}
{% endfor %}
          double rhs{{ stage }}_{{ i }} = {{ ns.current_F_prefix }}_{{ i }} + {{ sum_parts | join(" + ") }};
{% endif %}
{% endfor %}
{% set ns.rhs_prefix = "rhs" ~ stage %}
{% endif %}
{{ emit_forward_sub(forward_sub_steps, ns.rhs_prefix, "y" ~ stage, blocks=blocks, is_reduction=false, indent="          ", k_prefix="K" ~ stage) -}}
{{ emit_backward_sub(backward_sub_steps, "y" ~ stage, "K" ~ stage, blocks=blocks, is_reduction=false, indent="          ") -}}
{% endfor %}

          // --- Solution update and error estimation ---
          double err_norm_sq = 0.0;
{% for i in range(num_species) %}
{% if permutation %}
{% set state_idx = permutation[i] %}
{% else %}
{% set state_idx = i %}
{% endif %}
{% set m_terms = [] %}
{% for j in range(tableau.stages) %}
{% if tableau.M[j] != 0.0 %}
{% set _ = m_terms.append((tableau.M[j], "K" ~ (j + 1) ~ "_" ~ i)) %}
{% endif %}
{% endfor %}
{% if m_terms | length > 0 %}
{% set m_parts = [] %}
{% for t in m_terms %}
{% if t[0] == 1.0 %}
{% set _ = m_parts.append(t[1]) %}
{% else %}
{% set _ = m_parts.append("%.17g" | format(t[0]) ~ " * " ~ t[1]) %}
{% endif %}
{% endfor %}
{% set m_expr = m_parts | join(" + ") %}
{% else %}
{% set m_expr = "0.0" %}
{% endif %}
{% set e_terms = [] %}
{% for j in range(tableau.stages) %}
{% if tableau.E[j] != 0.0 %}
{% set _ = e_terms.append((tableau.E[j], "K" ~ (j + 1) ~ "_" ~ i)) %}
{% endif %}
{% endfor %}
{% if e_terms | length > 0 %}
{% set e_parts = [] %}
{% for t in e_terms %}
{% if t[0] == 1.0 %}
{% set _ = e_parts.append(t[1]) %}
{% else %}
{% set _ = e_parts.append("%.17g" | format(t[0]) ~ " * " ~ t[1]) %}
{% endif %}
{% endfor %}
{% set e_expr = e_parts | join(" + ") %}
{% else %}
{% set e_expr = "0.0" %}
{% endif %}
          {
              double Ynew_i = S_{{ i }} + {{ m_expr }};
              double ymax = Kokkos::fmax(Kokkos::fabs(state({{ state_idx }})), Kokkos::fabs(Ynew_i));
              double sci = atol[{{ i }}] + rtol[{{ i }}] * ymax;
              double yerr_i = {{ e_expr }};
              err_norm_sq += (yerr_i / sci) * (yerr_i / sci);
          }
{% endfor %}
          double err_norm = Kokkos::sqrt(err_norm_sq / {{ num_species }});
          err_norm = Kokkos::fmax(err_norm, 1.0e-10);

{% set elo_exponent = 1.0 / tableau.ELO %}
          // Step Size Control (order {{ tableau.ELO | int }}: exponent = 1/{{ tableau.ELO | int }} = {{ "%.17g" | format(elo_exponent) }})
{% if tableau.ELO == 2.0 %}
          double factor = safety / Kokkos::sqrt(err_norm);
{% elif tableau.ELO == 3.0 %}
          double factor = safety / Kokkos::cbrt(err_norm);
{% else %}
          double factor = safety * Kokkos::pow(err_norm, -{{ "%.17g" | format(elo_exponent) }});
{% endif %}
          factor = Kokkos::fmax(min_shrink, Kokkos::fmin(factor, max_growth));

          if (err_norm <= 1.0) {
{% for i in range(num_species) %}
{% if permutation %}
{% set state_idx = permutation[i] %}
{% else %}
{% set state_idx = i %}
{% endif %}
{% set m_terms = [] %}
{% for j in range(tableau.stages) %}
{% if tableau.M[j] != 0.0 %}
{% set _ = m_terms.append((tableau.M[j], "K" ~ (j + 1) ~ "_" ~ i)) %}
{% endif %}
{% endfor %}
{% if m_terms | length > 0 %}
{% set m_parts = [] %}
{% for t in m_terms %}
{% if t[0] == 1.0 %}
{% set _ = m_parts.append(t[1]) %}
{% else %}
{% set _ = m_parts.append("%.17g" | format(t[0]) ~ " * " ~ t[1]) %}
{% endif %}
{% endfor %}
{% set m_expr = m_parts | join(" + ") %}
{% else %}
{% set m_expr = "0.0" %}
{% endif %}
              state({{ state_idx }}) += {{ m_expr }};
{% endfor %}
              t += dt;
              dt *= factor;
          } else {
              dt *= factor;
          }
          } // end while (t < dt_total)
      }
