# Generated solver output (regenerated by mkpp AOT compiler)
# mkpp-generated/ is tracked so host models can use MKPP without the Python codegen toolchain.
# CI regenerates these before building to verify freshness.
mkpp-generated/*_manifest.json
mkpp-generated-*/
src/solvers/

# Legacy spec-kit tooling (replaced by .kiro/specs/)
.specify/
specs/
.kiro*/
kpp*/
